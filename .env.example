# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string. `npm run db:up` starts a local one matching this.
DATABASE_URL=postgres://engrafo:engrafo@127.0.0.1:5436/engrafo

# Secret used to sign session and magic-link tokens. The server refuses to start
# in production while this is unset or still the default.
# Generate one with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# S3-compatible object storage. `npm run db:up` starts a local MinIO matching these.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=engrafo
S3_ACCESS_KEY_ID=engrafo
S3_SECRET_ACCESS_KEY=engrafo-dev-secret

# ── Optional ──────────────────────────────────────────────────────────────────

# The address the *browser* reaches the bucket at. Presigned upload and download
# URLs are signed for this host, so it cannot be rewritten afterwards. Defaults
# to S3_ENDPOINT, which is right whenever the server and the browser see the
# bucket at the same address.
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# Where extracted text is stored. It is kept apart from the files because it is
# written by the pipeline, not by a browser, and is never served as a document.
# Defaults to S3_BUCKET with `-text` appended; either way the bucket must exist.
# S3_TEXT_BUCKET=engrafo-text

# Default: us-east-1. MinIO ignores it; AWS does not.
# S3_REGION=us-east-1

# Public URL the app is served at. Magic-link URLs are built from it.
# Defaults to http://localhost:PORT.
# APP_URL=http://localhost:3004

# Port the server listens on. Default: 3004
# PORT=3004

# Largest accepted upload in bytes. Default: 104857600 (100 MiB)
# MAX_UPLOAD_BYTES=104857600

# Set to "false" to turn OCR off. When on, it also needs `ocrmypdf` on PATH —
# the Docker image has it; running from source needs a local install.
# OCR_ENABLED=true

# Whether the upload form's OCR toggle starts on. Default: true
# OCR_DEFAULT=true

# Tesseract languages, joined with "+" (e.g. eng+deu). Each needs its
# traineddata installed. Default: eng
# OCR_LANGUAGES=eng

# Documents processed at once. OCR is CPU-bound. Default: 1
# OCR_CONCURRENCY=1

# Set to "false" to skip magic-link verification entirely: requesting a link
# signs you straight in. Private self-hosted instances only.
# AUTH_MAGIC_LINK=true

# Return the magic link in the API response. Defaults to true outside production.
# EXPOSE_MAGIC_LINK=false

# Where `npm run dev:app` proxies /graphql. Default: http://localhost:3004
# ENGRAFO_SERVER_URL=http://localhost:3004

# Address `npm run db:up` publishes Postgres and MinIO on. Defaults to
# 127.0.0.1, which is the loopback of whichever machine runs the Docker daemon —
# so if `docker context ls` shows a remote endpoint, set this to 0.0.0.0 and
# point DATABASE_URL and S3_ENDPOINT at that host. Trusted networks only.
# DEV_BIND=127.0.0.1
