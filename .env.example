# Required.

# PostgreSQL connection string. `npm run db:up` starts a local one matching this.
DATABASE_URL=postgres://engrafo:engrafo@127.0.0.1:5436/engrafo

# How long boot waits for Postgres to answer before giving up, in milliseconds.
# DB_CONNECT_TIMEOUT_MS=60000

# Secret better-auth signs sessions and hashes magic-link tokens with. The server
# refuses to start in production while this is unset, shorter than 32 characters
# or still the default.
# Generate one with: openssl rand -hex 32
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# S3-compatible object storage. `npm run db:up` starts a local RustFS matching these.
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=engrafo
S3_ACCESS_KEY_ID=engrafo
S3_SECRET_ACCESS_KEY=engrafo-dev-secret

# Optional.

# The address the *browser* reaches the bucket at. Presigned upload and download
# URLs are signed for this host, so it cannot be rewritten afterwards. Defaults
# to S3_ENDPOINT, which is right whenever the server and the browser see the
# bucket at the same address.
# S3_PUBLIC_ENDPOINT=http://localhost:9000

# Where extracted text is stored. It is kept apart from the files because it is
# written by the pipeline, not by a browser, and is never served as a document.
# Defaults to S3_BUCKET with `-text` appended; either way the bucket must exist.
# S3_TEXT_BUCKET=engrafo-text

# Default: us-east-1. RustFS ignores it; AWS does not.
# S3_REGION=us-east-1

# Default: true, which addresses buckets as host/bucket, the way RustFS and
# MinIO expect. Set it to false for AWS S3, which prefers bucket.host.
# S3_FORCE_PATH_STYLE=true

# Public URL the app is served at. Magic-link URLs and the OIDC redirect URI
# are built from it.
# Unset, each request uses the address the browser came in on (behind a proxy,
# set TRUST_PROXY so the forwarded host and scheme are believed).
# APP_URL=http://localhost:3004

# Port the server listens on. Default: 3004
# PORT=3004

# Largest accepted upload in bytes. Default: 104857600 (100 MiB)
# MAX_UPLOAD_BYTES=104857600

# Set to "false" to turn OCR off. When on, it also needs `ocrmypdf` on PATH —
# the Docker image has it; running from source needs a local install.
# OCR_ENABLED=true

# Whether the upload form's OCR toggle starts on. Default: true
# OCR_DEFAULT=true

# Tesseract languages, joined with "+" (e.g. eng+deu). Each needs its
# traineddata installed. Default: eng
# OCR_LANGUAGES=eng

# Documents processed at once. OCR is CPU-bound. Default: 1
# OCR_CONCURRENCY=1

# How a numeric date that could be read either way (03/04/2025) is read from a
# document's text: DMY (day first), MDY (month first, as in the US) or YMD.
# A dotted date (03.04.2025) is always day first. Default: DMY
# DATE_ORDER=DMY

# "true" when nothing hostile can reach this port: entering an address signs you
# straight in, with no link to go and fetch. A LAN you control, and nowhere else,
# because it makes the address the entire credential.
# SECURE_LOCAL_NET=false

# Return the magic link in the API response. Defaults to true outside production.
# EXPOSE_MAGIC_LINK=false

# Sign-in through an OpenID Connect provider such as heautou, next to magic
# links. Easier: leave these unset and pair from the app by pasting a setup URL
# (login page on a new instance, Settings -> Sign-in after). Set here, they win
# over a pairing and it cannot be changed from the app. Set the issuer and
# client id together, or neither: one without the other stops the server at
# boot. Register the client's redirect URI as exactly
# APP_URL/api/auth/callback/oidc.
# OIDC_ISSUER=https://auth.example.com/oidc
# OIDC_CLIENT_ID=engrafo
# Leave unset for a public client.
# OIDC_CLIENT_SECRET=
# How the secret is sent: client_secret_basic (the default) or client_secret_post.
# OIDC_CLIENT_AUTH=client_secret_basic
# The provider's name on the login button ("Sign in with …"). Default: SSO
# OIDC_NAME=heautou

# Where sessions are kept. "memory" (the default) signs everyone out when the
# server restarts. "database" keeps them across a restart, and is what more than
# one replica needs.
# SESSION_STORE=memory

# Which proxy hops may set X-Forwarded-For: "false" with nothing in front, a hop
# count ("1") or a subnet list behind a reverse proxy. The sign-in throttle
# counts by client address, so behind a proxy this has to be set or every
# visitor shares the proxy's address and its budget.
# TRUST_PROXY=false

# Where `npm run dev:app` proxies /graphql and the OIDC routes. Default: http://localhost:3004
# ENGRAFO_SERVER_URL=http://localhost:3004

# Address `npm run db:up` publishes Postgres and RustFS on. Defaults to
# 127.0.0.1, which is the loopback of whichever machine runs the Docker daemon —
# so if `docker context ls` shows a remote endpoint, set this to 0.0.0.0 and
# point DATABASE_URL and S3_ENDPOINT at that host. Trusted networks only.
# DEV_BIND=127.0.0.1
