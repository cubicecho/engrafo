{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "plugins": ["./no-negation.grit"],
  "files": {
    "ignoreUnknown": true,
    "includes": ["**", "!**/dist", "!**/__generated__", "!**/drizzle", "!**/storybook-static", "!site", "!**/*.svg"]
  },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "javascript": { "formatter": { "quoteStyle": "single", "trailingCommas": "all", "semicolons": "always" } },
  "css": { "parser": { "tailwindDirectives": true } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error"
      },
      "style": {
        "useImportType": "error",
        "useBlockStatements": "error",
        "useConst": "error",
        "noMagicNumbers": "warn",
        "noCommonJs": "error",
        "noEnum": "error",
        "noNamespace": "error",
        "noParameterProperties": "error",
        "noNonNullAssertion": "error",
        "useFilenamingConvention": { "level": "error", "options": { "filenameCases": ["kebab-case"] } }
      },
      "suspicious": { "noExplicitAny": "error" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "overrides": [
    {
      "includes": [
        "**/components/ui/**",
        "app/src/components/*.tsx",
        "app/src/lib/utils.ts",
        "app/src/lib/format.ts",
        "app/src/lib/color.ts",
        "app/cubeui-*.css",
        "app/index.html"
      ],
      "linter": { "enabled": false },
      "formatter": { "enabled": false }
    },
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/tests/**", "**/__tests__/**", "**/bench/**"],
      "linter": { "rules": { "style": { "noMagicNumbers": "off" } } }
    }
  ]
}
