{
  "name": "engrafo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Engrafo — a minimal self-hostable document archive. Upload, store in S3, OCR.",
  "type": "module",
  "workspaces": [
    "app",
    "server",
    "db"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -n server,app \"npm run dev:server\" \"npm run dev:app\"",
    "dev:app": "npm run dev -w @cubicecho/engrafo-app",
    "dev:server": "npm run dev -w @cubicecho/engrafo-server",
    "build": "npm run codegen && npm run build -w @cubicecho/engrafo-app",
    "build:app": "npm run build -w @cubicecho/engrafo-app",
    "storybook": "npm run storybook -w @cubicecho/engrafo-app",
    "build-storybook": "npm run build-storybook -w @cubicecho/engrafo-app",
    "check": "npm run codegen && npm run check:biome && npm run check:types",
    "check:biome": "biome check --write .",
    "check:types": "tsc --noEmit -p db/tsconfig.json && tsc --noEmit -p server/tsconfig.json && tsc --noEmit -p app/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "codegen": "npm run codegen:server && npm run codegen:app",
    "codegen:app": "npm run codegen -w @cubicecho/engrafo-app",
    "codegen:server": "npm run codegen -w @cubicecho/engrafo-server",
    "db:generate": "npm run generate -w @cubicecho/engrafo-db",
    "db:migrate": "npm run migrate -w @cubicecho/engrafo-db",
    "db:push": "npm run push -w @cubicecho/engrafo-db",
    "db:studio": "npm run studio -w @cubicecho/engrafo-db",
    "db:up": "docker compose -f docker-compose.dev.yml up -d",
    "db:down": "docker compose -f docker-compose.dev.yml down"
  },
  "overrides": {
    "graphql": "16.14.2",
    "drizzle-orm": "1.0.0-rc.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@electric-sql/pglite": "^0.3.15",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/client-preset": "^6.2.3",
    "@graphql-codegen/schema-ast": "^6.1.1",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "1.0.0-rc.5",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
