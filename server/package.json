{
  "name": "@cubicecho/engrafo-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "start": "node src/index.ts",
    "codegen": "node --import=./src/core/preload-env.ts src/graphql/write-schema.ts && graphql-codegen-esm"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1133.0",
    "@cubicecho/engrafo-db": "*",
    "@vantreeseba/drizzle-graphql": "^13.0.0",
    "better-auth": "^1.7.7",
    "cors": "^2.8.6",
    "drizzle-orm": "1.0.0-rc.4",
    "express": "^5.2.1",
    "file-type": "^22.1.0",
    "graphql": "^16.10.0",
    "graphql-yoga": "^5.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6"
  }
}
