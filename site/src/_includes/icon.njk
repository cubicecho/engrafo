{# One stroke icon, picked by `icon`. Shapes are Lucide's (ISC licence), drawn
   in currentColor so they take the text colour around them. #}
<svg class="icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
{%- if icon == "upload" -%}
  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" x2="12" y1="3" y2="15"/>
{%- elif icon == "scan" -%}
  <path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><path d="M7 8h8"/><path d="M7 12h10"/><path d="M7 16h6"/>
{%- elif icon == "search" -%}
  <circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/>
{%- elif icon == "folder" -%}
  <path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"/>
{%- elif icon == "receipt" -%}
  <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z"/><path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8"/><path d="M12 17.5v-11"/>
{%- elif icon == "merge" -%}
  <circle cx="18" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><path d="M6 21V9a9 9 0 0 0 9 9"/>
{%- elif icon == "bot" -%}
  <path d="M12 8V4H8"/><rect width="16" height="12" x="4" y="8" rx="2"/><path d="M2 14h2"/><path d="M20 14h2"/><path d="M15 13v2"/><path d="M9 13v2"/>
{%- elif icon == "activity" -%}
  <path d="M22 12h-4l-3 9L9 3l-3 9H2"/>
{%- elif icon == "server" -%}
  <rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>
{%- elif icon == "check" -%}
  <path d="M20 6 9 17l-5-5"/>
{%- elif icon == "minus" -%}
  <path d="M5 12h14"/>
{%- elif icon == "chevron-left" -%}
  <path d="m15 18-6-6 6-6"/>
{%- elif icon == "chevron-right" -%}
  <path d="m9 18 6-6-6-6"/>
{%- elif icon == "arrow-right" -%}
  <path d="M5 12h14"/><path d="m12 5 7 7-7 7"/>
{%- endif -%}
</svg>
